VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_APP_TITLE=FixHome

# MapTiler key (public, restricted by Allowed HTTP Origins on the MapTiler console).
# Get a free key at https://cloud.maptiler.com/account/keys
VITE_MAPTILER_KEY=

# Google Sign-In — dung chung mot Client ID voi backend (xem backend/.env.example
# de biet cach tao). Gia tri nay cong khai vi no nam trong bundle ma trinh duyet
# tai ve; Client Secret chi backend giu, khong bao gio dat o day.
# Bo trong thi nut "Dang nhap voi Google" tu an di.
VITE_GOOGLE_CLIENT_ID=

# --- Goi thoai qua LAN (tuy chon, mac dinh tat) ---
# Trinh duyet chi cho phep dung micro tren trang https hoac localhost. Chay
# binh thuong o localhost thi khong can bat cai nay.
# Chi bat khi can mo app tu MAY KHAC trong cung mang bang dia chi IP, vi luc do
# http:// se lam getUserMedia bien mat han va khong goi duoc.
# Bat len thi Vite lang nghe tren moi interface va tu sinh chung chi tu ky;
# moi may phai bam qua canh bao chung chi mot lan.
# Day KHONG phai bien VITE_*: no chi cau hinh dev server, khong nam trong bundle,
# nen khong can them vao Dockerfile.
DEV_HTTPS=false
